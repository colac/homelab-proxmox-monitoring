---
# GENERATED BY TERRAFORM (terraform/projects/monitoring) — DO NOT EDIT.
# Regenerate with: cd terraform/projects/monitoring && terraform apply
#
# ansible/inventory/ is a directory inventory, so this file is merged with the
# other fragments in it. Host/group tuning belongs in inventory/group_vars/,
# which Terraform never writes.
#
# Proxmox VM name: ${proxmox_vm_name}
# The inventory host name differs from it on purpose — Ansible warns when a
# host and a group share a name, and one of the groups here is `monitoring`.
#
# The single host joins several groups because it genuinely plays every role
# the six-VM Elastic cluster spread across separate machines: it is the
# Elasticsearch node, the Kibana node, and the Fleet Server host. Keeping the
# group names identical to that cluster's is what lets the roles port over
# with their `groups['elasticsearch'][0]` lookups intact — collapse the groups
# and every one of those expressions would need rewriting.
all:
  children:
    monitoring:
      hosts:
        ${inventory_hostname}:
          ansible_host: ${vm_ip}
          ansible_user: ${vm_user}
    elasticsearch:
      hosts:
        ${inventory_hostname}:
    kibana:
      hosts:
        ${inventory_hostname}:
