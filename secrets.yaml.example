---
# ============================================================================
# Reference copy of secrets.yaml — plaintext, tracked, PLACEHOLDERS ONLY.
#
# The real file is secrets.yaml: same keys, real values, SOPS-encrypted with
# age, committed as ciphertext. This example exists because a reader without
# the age key cannot see the key names inside the encrypted file.
#
#   mise run secrets:edit      # decrypt -> VS Code -> re-encrypt on save
#   mise run secrets:check     # which keys are missing (never prints values)
#
# Nothing reads this file directly. .mise/sops-exec decrypts it for one
# command and hands over only what that command needs:
#   terraform profile  ->  TF_VAR_pm_api_*, TF_VAR_pm_tls_insecure, TF_TOKEN_*
#   ansible profile    ->  the UPPERCASE names group_vars reads with lookup('env')
#
# Only human-chosen secrets belong here. What the stack generates itself (the
# internal CA, the node certificate, Fleet service and enrollment tokens) is
# cached under ansible/.certs/ and ansible/.secrets-cache/, both git-ignored.
# Keep this file's KEYS in sync with secrets.yaml; never put a real value here.
# ============================================================================

# ----------------------------------------------------------------------------
# Infrastructure — terraform profile
# ----------------------------------------------------------------------------
# Base API endpoint, no /api2/json suffix — sops-exec appends it.
proxmox_endpoint: "https://pve.example.com:8006"

# terraform@pve token (clone/configure rights). Ideally its own token per repo
# (terraform@pve!terraform-monitoring) so revoking one cannot break another —
# see the core repo's terraform/README.md for the pveum commands.
proxmox_terraform_token_id: "terraform@pve!terraform-automation"
proxmox_terraform_token_secret: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# app.terraform.io API token (org colac_homelab). Workspaces run in Local
# execution mode, but state lives in TFC, so `terraform init` needs one.
# Leave empty to fall back to `terraform login` credentials.
tf_cloud_token: ""

# ----------------------------------------------------------------------------
# Elastic Stack — ansible profile
# ----------------------------------------------------------------------------
# The `elastic` superuser. Bootstraps everything else and logs in to Kibana.
elastic_password: "CHANGE_ME"

# The built-in kibana_system user. Kibana authenticates to Elasticsearch as
# this least-privilege account, never as `elastic`.
kibana_system_password: "CHANGE_ME"

# Fleet encrypts the service tokens and API keys it stores as Kibana saved
# objects with this. POST /api/fleet/setup fails outright without it.
#   openssl rand -hex 32
kibana_encryption_key: "CHANGE_ME"

# ----------------------------------------------------------------------------
# Kibana's Let's Encrypt certificate (kibana_tls) — ansible profile
# ----------------------------------------------------------------------------
# Nextcloud's public hostname. Not a secret, but kept here so the real domain
# stays out of the repo. Kibana's name is derived from its zone
# (kibana.<zone>), and the Nextcloud exporter scrapes it.
nextcloud_domain: "nextcloud.example.com"

# Let's Encrypt account email (expiry notices).
acme_email: "you@example.com"

# Cloudflare API token for ACME DNS-01, scoped Zone:DNS:Edit on your zone.
# This repo's OWN token — the workloads repo's Caddy has a separate one.
cloudflare_dns_api_token: "CHANGE_ME"

# ----------------------------------------------------------------------------
# Exporters — ansible profile
# ----------------------------------------------------------------------------
# Nextcloud serverinfo API token for the application-metrics exporter. A
# dedicated token rather than an admin account, so the monitoring VM holds no
# credential that can log in. Generate on the Nextcloud VM:
#   docker exec -u www-data nextcloud-aio-nextcloud \
#     php occ config:app:set serverinfo token --value "$(openssl rand -hex 32)"
nextcloud_serverinfo_token: "CHANGE_ME"

# Proxmox host metrics. Optional — only read once exporters_pve_enabled is
# true in ansible/inventory/group_vars/monitoring.yml. Read-only PVEAuditor
# token; see RUNBOOK.md for the pveum commands.
pve_exporter_token_id: "pve-exporter@pve!monitoring"
pve_exporter_token_secret: ""
