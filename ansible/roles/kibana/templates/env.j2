KIBANA_IMAGE={{ kibana_image }}
KIBANA_PORT={{ kibana_port }}
# Point Kibana at every ES node's HTTP endpoint. Kibana's docker-entrypoint
# passes env values straight through as CLI longopts
# (--elasticsearch.hosts=<value>) with no comma-splitting of its own — the
# array-typed elasticsearch.hosts setting only accepts either one URI or a
# JSON-encoded array string. A plain comma-joined list fails config validation
# ("could not parse array value from json input"); verified empirically
# against a live cluster. The JSON must also be whitespace-free: the
# entrypoint's final `exec ... ${longopts}` line expands unquoted, so bash
# word-splits on any space and shreds the array into garbage argv — also
# verified empirically.
ES_HOSTS={{ (groups['elasticsearch'] | map('extract', hostvars, 'ansible_host') | map('regex_replace', '^', 'https://' if (es_security_enabled | bool) else 'http://') | map('regex_replace', '$', ':' ~ es_http_port) | list) | to_json | replace(', ', ',') }}
PUBLIC_BASE_URL={{ kibana_publicbaseurl }}
{% if es_security_enabled | bool %}

# kibana_system, not elastic — least-privilege built-in user for Kibana's own
# ES connection. Plain var, not _FILE: Kibana's docker image does not support
# the _FILE-suffix convention Elasticsearch's does (elastic/kibana#39605 is
# still open).
ELASTICSEARCH_USERNAME=kibana_system
ELASTICSEARCH_PASSWORD={{ kibana_system_password }}
ELASTICSEARCH_SSL_CERTIFICATEAUTHORITIES=/usr/share/kibana/config/certs/ca.crt
{% endif %}
{% if fleet_server_enabled | default(false) | bool %}

KIBANA_ENCRYPTION_KEY={{ kibana_encryption_key }}
{% endif %}
