# Rendered by Ansible (role: elasticsearch) — edit the template, not this file.
#
# Single node, but the discovery settings are still derived from the
# `elasticsearch` inventory group rather than hard-coded to "itself". That
# keeps the template honest about what it means, and means adding a second
# node would be an inventory change rather than a template rewrite.
ES_IMAGE={{ es_image }}
NODE_NAME={{ es_node_name }}
CLUSTER_NAME={{ cluster_name }}
PUBLISH_HOST={{ ansible_host }}

# discovery.seed_hosts: every ES node's transport endpoint.
SEED_HOSTS={{ groups['elasticsearch'] | map('extract', hostvars, 'ansible_host') | map('regex_replace', '$', ':' ~ es_transport_port) | join(',') }}

# cluster.initial_master_nodes: node names. Only consulted on first
# formation — es_bootstrap_cluster gates whether it is emitted at all.
INITIAL_MASTER_NODES={{ groups['elasticsearch'] | map('extract', hostvars, 'es_node_name') | join(',') }}

HEAP_SIZE={{ es_heap_size }}
MEMORY_LOCK={{ es_bootstrap_memory_lock | lower }}
SECURITY_ENABLED={{ es_security_enabled | lower }}
HTTP_PORT={{ es_http_port }}
TRANSPORT_PORT={{ es_transport_port }}
