FLEET_SERVER_IMAGE={{ fleet_server_image }}
FLEET_SERVER_PORT={{ fleet_server_port }}
FLEET_SERVER_POLICY_ID={{ fleet_server_policy_id }}
# Single ES endpoint — FLEET_SERVER_ELASTICSEARCH_HOST takes one host, not a
# list (unlike Kibana's ELASTICSEARCH_HOSTS/apm-server's output.elasticsearch
# .hosts). Homelab-scale simplification, same kind already accepted for the
# shared standalone Elastic Agent API key — see docs/ANSIBLE.md.
FLEET_SERVER_ELASTICSEARCH_HOST=https://{{ hostvars[groups['elasticsearch'][0]].ansible_host }}:{{ es_http_port }}
# id:token, minted once by the fleet_bootstrap role (see
# playbooks/35-fleet-server.yml) via the ES service-token API — not the
# elastic superuser.
FLEET_SERVER_SERVICE_TOKEN={{ lookup('file', es_secrets_local_cache_dir ~ '/fleet_server_service_token.txt') }}
# Self-enrollment URL — a Fleet Server is itself always an enrolled Elastic
# Agent, so the container also enrolls against the Fleet Server it just
# started (itself). Same host/port fleet_bootstrap registered via
# POST /api/fleet/fleet_server_hosts.
FLEET_URL=https://{{ ansible_host }}:{{ fleet_server_port }}
