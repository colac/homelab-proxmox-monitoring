# Managed by Ansible.
services:
  fleet-server:
    image: ${FLEET_SERVER_IMAGE}
    container_name: fleet-server
    restart: unless-stopped
    environment:
      - FLEET_SERVER_ENABLE=true
      - FLEET_SERVER_ELASTICSEARCH_HOST=${FLEET_SERVER_ELASTICSEARCH_HOST}
      - FLEET_SERVER_ELASTICSEARCH_CA=/certs/ca.crt
      - FLEET_SERVER_SERVICE_TOKEN=${FLEET_SERVER_SERVICE_TOKEN}
      - FLEET_SERVER_POLICY_ID=${FLEET_SERVER_POLICY_ID}
      - FLEET_SERVER_CERT=/certs/server.crt
      - FLEET_SERVER_CERT_KEY=/certs/server.key
      - FLEET_SERVER_PORT=${FLEET_SERVER_PORT}
      - FLEET_SERVER_HOST=0.0.0.0
      # A Fleet Server is itself always an enrolled Elastic Agent — the
      # container also self-enrolls against the Fleet Server it just
      # started, which needs a URL to enroll against (itself) and a CA to
      # trust that cert. Without these: "Error: url is required when a
      # certificate is provided" / "enrollment failed" — verified
      # empirically, container crash-looped without them.
      - FLEET_URL=${FLEET_URL}
      - FLEET_CA=/certs/ca.crt
    volumes:
      - ./certs:/certs:ro
    ports:
      - "${FLEET_SERVER_PORT}:8220"
    # No curl (or wget/nc) in this image — verified empirically, same as
    # the apm-server image. /bin/sh here is bash too, so a bare TCP-connect
    # via /dev/tcp needs nothing extra and is enough to confirm the server
    # is accepting connections.
    healthcheck:
      test: ["CMD-SHELL", "exec 3<>/dev/tcp/127.0.0.1/8220 || exit 1"]
      interval: 20s
      timeout: 10s
      retries: 12
