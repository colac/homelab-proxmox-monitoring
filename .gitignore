# Packer
packer-manifest.json
packer_cache/
# https://www.packer.io/guides/hcl/variables
# Exclude all .pkrvars.hcl files, which are likely to contain sensitive data,
# such as password, private keys, and other secrets. These should not be part of
# version control as they are data points which are potentially sensitive and
# subject to change depending on the environment.
#
*.pkrvars.hcl
*.auto.pkvars.hcl
crash.log
*.box

# Secrets and credentials
secrets/
*.secret
*.key
*.pem
*.p12
*.pfx

# Ansible
*.retry
.ansible/
ansible.log
# Real inventory — keep only the .example
ansible/inventory/hosts.yml
# Legacy: secrets moved to the SOPS-encrypted secrets.yaml at the repo root.
# Kept ignored so an old local vault.yml can never be committed by accident.
ansible/vault.yml
# Terraform-generated inventory fragments. One per project; each holds the
# DHCP address its VM happens to have, so they are machine state, not source.
# group_vars/ is hand-authored and stays tracked.
ansible/inventory/monitoring.yml
# Generated Elastic material, cached controller-locally: the internal CA and
# node certificate, and the Fleet service/enrollment tokens. Machine state, not
# human-chosen secrets — those live in the ansible-vault file above. Losing
# these is recoverable (the roles regenerate them against an empty cluster);
# committing them would not be.
ansible/.certs/
ansible/.secrets-cache/

