# Ansible
*.retry
.ansible/
ansible.log
# Collections installed by `mise run setup` (ansible.cfg collections_path).
ansible/collections/
# Legacy: an old local vault.yml must never be committed by accident.
ansible/vault.yml
# Hand-authored agent targets — real addresses; keep only the .example.
ansible/inventory/hosts.yml
# Generated by Terraform (terraform/): the VM's DHCP address is machine state.
# group_vars/ is hand-authored and stays tracked.
ansible/inventory/monitoring.yml
# Generated Elastic material, cached controller-locally: the internal CA and
# node certificate, and the Fleet service/enrollment tokens. Machine state, not
# human-chosen secrets — those live in secrets.yaml. Losing these is
# recoverable (the roles regenerate them against an empty cluster); committing
# them would not be.
ansible/.certs/
ansible/.secrets-cache/

